# ── Environment / Credentials ──────────────────────
.env
.env.*
!.env.example
!.env.local.example
*.local

# ── Python ────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg
venv/
.venv/
env/

# ── Node / Next.js ────────────────────────────────
node_modules/
.next/
out/
package-lock.json

# ── Eval results ──────────────────────────────────
# Raw eval output is data, not source. Commit a baseline worth keeping with
# `git add -f evals/results/<file>.json`.
backend/evals/results/

# ── SQLite / Data ─────────────────────────────────
*.db
*.sqlite
*.sqlite3
# Database backups. `*.db` does not match `auth.db.bak.<timestamp>`, and these
# hold password and session hashes.
*.db.bak*

# ── Runtime logs & build artifacts ────────────────
.logs/
*.tsbuildinfo

# ── IDE / OS ──────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
