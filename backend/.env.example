# Sitescore - Multi-Agent Benchmarking Engine
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4o
CORS_ORIGINS=http://localhost:3000

# Dev server bind. Deployment platforms usually inject PORT.
HOST=0.0.0.0
PORT=8000

# Authentication & quotas
# AUTH_ENABLED=false leaves every /api route open — local development only.
AUTH_ENABLED=true
DEFAULT_RPM_LIMIT=10
DEFAULT_MAX_CONCURRENT=2
DEFAULT_DAILY_TOKEN_LIMIT=2000000
GLOBAL_DAILY_TOKEN_LIMIT=20000000

# Optional: for cost reporting only. Quotas are enforced in tokens, so leaving
# these at 0 changes nothing except that runs are not logged in dollars.
OPENAI_COST_PER_1M_INPUT=0
OPENAI_COST_PER_1M_OUTPUT=0

# How long a browser login stays valid before re-authentication.
SESSION_TTL_HOURS=168

# ── Competitor data ─────────────────────────────────────────────
# Where competitors come from.
#   web        — open-web discovery across any platform (production default)
#   rainforest — Amazon only, via the Rainforest product API
#   llm        — model estimates; development only, and the labelled fallback
# Selling benchmark scores against estimated competitors is not defensible, so
# production must run on a live provider.
COMPETITOR_PROVIDER=web

# --- Web discovery (Serper) -------------------------------------
# /shopping finds merchant-attributed products with price and rating;
# /search finds the direct-to-consumer stores shopping feeds under-represent.
# Both keys below travel in request headers, never in a URL.
SERPER_API_KEY=
SERPER_COUNTRY=us
SERPER_LANGUAGE=en
SERPER_RESULTS_PER_QUERY=20

# --- Page extraction (Firecrawl) --------------------------------
# Reads every competitor page, and the user's own listing when they paste a URL.
# Structured schema.org data is parsed in Python first; the model is only asked
# for fields the page did not publish.
FIRECRAWL_API_KEY=
FIRECRAWL_MAX_CONCURRENCY=5
FIRECRAWL_TIMEOUT_SECONDS=30

# Whole-stage deadline for reading competitor pages. Whatever has not returned
# is marked discovery-only and the run continues, rather than hanging.
EXTRACT_DEADLINE_SECONDS=60

# Below this many characters, extracted text is navigation chrome or a consent
# banner rather than listing copy. Scoring it would drag the benchmark down and
# flatter the user's percentile.
MIN_EXTRACTED_CHARS=200

# No more than this many competitors from one storefront, so a single
# marketplace cannot fill the competitive set.
COMPETITOR_MAX_PER_DOMAIN=4

# A same-platform cohort smaller than this is not a benchmark. Below it the
# headline percentile falls back to the whole-category cohort and says so.
BENCHMARK_MIN_COHORT=4

# --- Amazon-only provider (optional) ----------------------------
RAINFOREST_API_KEY=

# First analysis in a subcategory pays for discovery and extraction; the rest of
# the day is served from cache. 0 disables caching.
COMPETITOR_CACHE_TTL_HOURS=24

# Continue with clearly-labelled estimated data when the live provider fails,
# rather than failing the run outright. The result records that it happened.
COMPETITOR_ALLOW_FALLBACK=true

# --- Endpoint and timeout overrides (defaults shown; all optional) ---
SERPER_BASE_URL=https://google.serper.dev
SERPER_TIMEOUT_SECONDS=20
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
RAINFOREST_BASE_URL=https://api.rainforestapi.com/request
RAINFOREST_TIMEOUT_SECONDS=45
RAINFOREST_MAX_CONCURRENCY=5

# LLM resilience (defaults shown; all optional)
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=1.0
LLM_RETRY_MAX_DELAY=20.0

LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_your_key_here
LANGCHAIN_PROJECT=sitescore
